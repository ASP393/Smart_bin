WorldInfo {
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "trash"
      material2 "default"
      coulombFriction [ 0.75 ]
      bounce 0.22
      bounceVelocity 0.05
      softCFM 0.0008
      softERP 0.4
    }
    ContactProperties {
      material1 "trash"
      material2 "trash"
      coulombFriction [ 0.75 ]
      bounce 0.20
      bounceVelocity 0.05
    }
  ]
}
Viewpoint {
  orientation -0.14 0.37 0.92 0.78
  position -11.73 -10.84 5.31
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
  floorSize 8 8
  floorAppearance PBRAppearance {
    baseColor 0.88 0.89 0.92
    roughness 0.35
    metalness 0.02
  }
  wallHeight 0.12
  wallThickness 0.02
  wallAppearance PBRAppearance {
    baseColor 0.2 0.22 0.25
    roughness 0.4
    metalness 0.3
  }
}
# ===== REALISTIC PERSON (throws trash) =====
DEF PERSON Pedestrian {
  translation -2.7 0 1.27
  rotation 0 0 1 0
  name "person"
  controller "<none>"
  shirtColor 0.2 0.4 0.75
  pantsColor 0.15 0.18 0.25
  shoesColor 0.18 0.12 0.08
}
# ===== SMART BIN (wheels + chassis + camera + rangefinder) =====
DEF BIN Robot {
  translation 0 0 0.36
  rotation 0 0 1 0
  children [
    # --- 4 Omni-wheels ---
    Pose {
      translation 0.2 0.2 -0.33
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance DEF WHEEL_MAT PBRAppearance {
            baseColor 0.12 0.12 0.12
            roughness 0.4
            metalness 0.5
          }
          geometry Cylinder {
            radius 0.03
            height 0.04
          }
        }
      ]
    }
    Pose {
      translation -0.2 0.2 -0.33
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance USE WHEEL_MAT
          geometry Cylinder {
            radius 0.03
            height 0.04
          }
        }
      ]
    }
    Pose {
      translation 0.2 -0.2 -0.33
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance USE WHEEL_MAT
          geometry Cylinder {
            radius 0.03
            height 0.04
          }
        }
      ]
    }
    Pose {
      translation -0.2 -0.2 -0.33
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance USE WHEEL_MAT
          geometry Cylinder {
            radius 0.03
            height 0.04
          }
        }
      ]
    }
    # --- Chassis plate ---
    Pose {
      translation 0 0 -0.305
      children [
        Shape {
          appearance DEF CHASSIS_MAT PBRAppearance {
            baseColor 0.25 0.25 0.28
            roughness 0.6
            metalness 0.3
          }
          geometry Box {
            size 0.48 0.48 0.02
          }
        }
      ]
    }
    # --- Bin base ---
    Pose {
      translation 0 0 -0.285
      children [
        Shape {
          appearance DEF BIN_COLOR PBRAppearance {
            baseColor 0.1 0.4 0.9
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.56 0.56 0.03
          }
        }
      ]
    }
    # --- Wall +X ---
    Pose {
      translation 0.265 0 0.015
      children [
        Shape {
          appearance USE BIN_COLOR
          geometry Box {
            size 0.03 0.56 0.57
          }
        }
      ]
    }
    # --- Wall -X ---
    Pose {
      translation -0.265 0 0.015
      children [
        Shape {
          appearance USE BIN_COLOR
          geometry Box {
            size 0.03 0.56 0.57
          }
        }
      ]
    }
    # --- Wall +Y ---
    Pose {
      translation 0 0.265 0.015
      children [
        Shape {
          appearance USE BIN_COLOR
          geometry Box {
            size 0.5 0.03 0.57
          }
        }
      ]
    }
    # --- Wall -Y ---
    Pose {
      translation 0 -0.265 0.015
      children [
        Shape {
          appearance USE BIN_COLOR
          geometry Box {
            size 0.5 0.03 0.57
          }
        }
      ]
    }
    # --- High-Tech Depth Sensing Camera & Mount (Intel RealSense / OAK-D Style) ---
    # 1. Vertical mounting mast
    Pose {
      translation 0 0.24 0.36
      rotation 1 0 0 1.5708
      children [
        Shape {
          appearance DEF MAST_MAT PBRAppearance {
            baseColor 0.15 0.15 0.16
            roughness 0.35
            metalness 0.7
          }
          geometry Cylinder {
            radius 0.01
            height 0.14
          }
        }
      ]
    }
    # 2. Articulated mounting bracket
    Pose {
      translation 0 0.24 0.435
      children [
        Shape {
          appearance DEF BRACKET_MAT PBRAppearance {
            baseColor 0.25 0.25 0.28
            roughness 0.3
            metalness 0.8
          }
          geometry Box {
            size 0.035 0.025 0.018
          }
        }
      ]
    }
    # 3. Tilted Camera Unit (tilted 45 degrees towards thrower and sky)
    Pose {
      translation 0 0.24 0.45
      rotation 0 1 0 -0.7854
      children [
        # Main Camera Housing (Matte Space Gray)
        Pose {
          translation 0 0 0
          children [
            Shape {
              appearance DEF CAM_HOUSING PBRAppearance {
                baseColor 0.18 0.2 0.23
                roughness 0.3
                metalness 0.7
              }
              geometry Box {
                size 0.12 0.028 0.032
              }
            }
          ]
        }
        # Front Glass Faceplate (Glossy Black Visor)
        Pose {
          translation 0 0 0.017
          children [
            Shape {
              appearance DEF GLASS_VISOR PBRAppearance {
                baseColor 0.03 0.03 0.04
                roughness 0.05
                metalness 0.95
              }
              geometry Box {
                size 0.112 0.024 0.002
              }
            }
          ]
        }
        # Left Lens: RGB Sensor Optical Glass
        Pose {
          translation -0.028 0 0.019
          rotation 1 0 0 1.5708
          children [
            Shape {
              appearance DEF LENS_GLASS PBRAppearance {
                baseColor 0.02 0.02 0.08
                emissiveColor 0.01 0.01 0.05
                roughness 0.02
                metalness 0.98
              }
              geometry Cylinder {
                radius 0.008
                height 0.003
              }
            }
          ]
        }
        # Right Lens: Depth / Infrared Sensor Glass
        Pose {
          translation 0.028 0 0.019
          rotation 1 0 0 1.5708
          children [
            Shape {
              appearance DEF IR_GLASS PBRAppearance {
                baseColor 0.08 0.02 0.02
                emissiveColor 0.03 0.01 0.01
                roughness 0.05
                metalness 0.9
              }
              geometry Cylinder {
                radius 0.007
                height 0.003
              }
            }
          ]
        }
        # Active Status Indicator (Glowing Cyan LED)
        Pose {
          translation 0 0 0.019
          children [
            Shape {
              appearance DEF STATUS_LED PBRAppearance {
                baseColor 0 0.8 1
                emissiveColor 0 0.8 1
                roughness 0.1
              }
              geometry Sphere {
                radius 0.0025
              }
            }
          ]
        }
        # Embedded Webots Camera Device (placed at front lens face)
        Camera {
          translation -0.028 0 0.026
          rotation 0 0 1 0
          name "camera"
          fieldOfView 1.8
          width 320
          height 240
          near 0.02
        }
        # Embedded Webots RangeFinder Device (placed at front lens face)
        RangeFinder {
          translation 0.028 0 0.026
          rotation 0 0 1 0
          name "range_finder"
          fieldOfView 1.8
          width 320
          height 240
          near 0.02
          maxRange 10
        }
      ]
    }
  ]
  name "bin"
  boundingObject Group {
    children [
      Pose {
        translation 0 0 -0.285
        children [
          Box {
            size 0.56 0.56 0.03
          }
        ]
      }
      Pose {
        translation 0.265 0 0.015
        children [
          Box {
            size 0.03 0.56 0.57
          }
        ]
      }
      Pose {
        translation -0.265 0 0.015
        children [
          Box {
            size 0.03 0.56 0.57
          }
        ]
      }
      Pose {
        translation 0 0.265 0.015
        children [
          Box {
            size 0.5 0.03 0.57
          }
        ]
      }
      Pose {
        translation 0 -0.265 0.015
        children [
          Box {
            size 0.5 0.03 0.57
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 5
  }
  controller "bin_controller"
  supervisor TRUE
}
