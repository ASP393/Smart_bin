#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/humans/pedestrian/protos/Pedestrian.proto"

WorldInfo {
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      material1 "trash"
      material2 "default"
      coulombFriction [ 0.75 ]
      bounce 0.22
      bounceVelocity 0.05
      softCFM 0.0008
      softERP 0.4
    }
    ContactProperties {
      material1 "trash"
      material2 "trash"
      coulombFriction [ 0.75 ]
      bounce 0.20
      bounceVelocity 0.05
    }
  ]
}
Viewpoint {
  orientation 1 0 0 1.333
  position -1.25 -6.20 2.20
  near 0.1
}
Background {
  skyColor [
    0.42 0.68 0.92
  ]
  luminosity 1.1
}
DirectionalLight {
  direction 0.6 0.4 -1
  intensity 2.4
  castShadows TRUE
}
DirectionalLight {
  direction -0.6 -0.4 -0.8
  intensity 0.6
  castShadows FALSE
}

# ===== SMART CAMPUS COURTYARD ARENA =====
RectangleArena {
  floorSize 8 8
  floorAppearance PBRAppearance {
    baseColor 0.82 0.80 0.76
    roughness 0.85
    metalness 0.04
  }
  wallHeight 0.14
  wallThickness 0.03
  wallAppearance PBRAppearance {
    baseColor 0.42 0.43 0.45
    roughness 0.7
    metalness 0.1
  }
}

